FROM python:3.11-slim RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/* WORKDIR /app COPY requirements.txt . RUN pip install --no-cache-dir -r requirements.txt COPY . . ENV PORT=8080 EXPOSE 8080 CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:8080", "--timeout", "600", "ego.webapp:app"]
